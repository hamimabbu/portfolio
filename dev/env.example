# Copy this file to .env.local in the site folder and fill in what you use.
# Never commit .env.local. The .gitignore already blocks it.

# Optional. Without any key the assistant still works, using only the written facts.
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional. Any other service that uses the same request shape as Groq (OpenRouter, Cerebras, Mistral and more).
# All three are needed. The base URL ends before /chat/completions.
OTHER_AI_KEY=
OTHER_AI_BASE_URL=
OTHER_AI_MODEL=

# Optional. Which provider to try first, comma separated. Default is groq,gemini,other
# Each one that has a key is tried in this order, and the next one takes over if one is down or out of free quota.
AI_PROVIDERS=groq,gemini,other

# Optional. Change these when a provider renames or retires a model.
GROQ_MODEL=
GEMINI_MODEL=

# Optional. Only needed if the site is served from more than one address.
ALLOWED_ORIGINS=
